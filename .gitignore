# Зависимости и сборка
node_modules/
dist/
*.tsbuildinfo

# Rust
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Сайт документации
apps/docs/.vitepress/cache/
apps/docs/.vitepress/dist/

# Сайт дизайн-системы: стайлгайд и макеты экранов (VitePress).
apps/design/.vitepress/cache/
apps/design/.vitepress/dist/

# Токены приложения на .t-light/.t-dark для витрины — панели ThemePair.vue
# показывают обе темы разом независимо от темы зрителя, `:root[data-theme]`
# внутри страницы не сработает. Генерируется `tools/build-preview-tokens.mjs`
# из apps/desktop/src/styles/tokens.css — источник там, дублировать в истории
# незачем.
apps/design/.vitepress/theme/preview-tokens.css

# Стенд разработки: junction на системный Python в git не кладётся,
# фикстура создаётся скриптом (см. «Разработка» в plan/dev.md).
tools/fixtures/fake-instance/python_embeded/

# Копия стенда по пути с пробелом и кириллицей: тот же скрипт делает её
# из основного стенда, держать в истории два одинаковых дерева незачем.
tools/fixtures/стенд с пробелом/

# Стенд общей папки моделей: полсотни пустых файлов, целиком генерируется
# скриптом make-shared-root.mjs. В истории им делать нечего.
tools/fixtures/shared-models/

# Стенд библиотеки воркфлоу, по той же причине: воспроизводится
# скриптом make-workflow-library.mjs.
tools/fixtures/workflow-library/

# Локальное окружение
.env
.env.local
*.local

# Редакторы и ОС
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Личные настройки Claude Code. Общие правила лежат в .claude/settings.json
# и CLAUDE.md — они версионируются.
.claude/settings.local.json
.claude/hook-events.log

.cc-connect

# Исходники логотипа и нарезчик к ним живут вне репозитория: в проекте
# лежит только результат — иконки Tauri и SVG сайта. Пока папка ещё
# не унесена, эти строки держат её вне индекса.
/brand/
/tools/logo-build.mjs
