# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Rust
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Documentation site
apps/docs/.vitepress/cache/
apps/docs/.vitepress/dist/

# Design system site: style guide and screen mockups (VitePress).
apps/design/.vitepress/cache/
apps/design/.vitepress/dist/

# The app's tokens on .t-light/.t-dark for the showcase — the ThemePair.vue
# panels show both themes at once regardless of the viewer's theme, and
# `:root[data-theme]` will not fire inside a page. Generated by
# `tools/build-preview-tokens.mjs` from apps/desktop/src/styles/tokens.css —
# the source is there, no reason to duplicate it in history.
apps/design/.vitepress/theme/preview-tokens.css

# Development rig: a junction to the system Python is not put into git, the
# fixture is created by tools/fixtures/make-fixture.mjs.
tools/fixtures/fake-instance/python_embeded/

# The copy of the rig under a path with a space and non-ASCII characters: the
# same script builds it from the main rig, and there is no reason to keep two
# identical trees in history.
tools/fixtures/стенд с пробелом/

# The shared models folder rig: fifty-odd empty files, generated entirely by
# make-shared-root.mjs. They have no business in history.
tools/fixtures/shared-models/

# The workflow library rig, for the same reason: reproduced by
# make-workflow-library.mjs.
tools/fixtures/workflow-library/

# Local environment
.env
.env.local
*.local

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Personal Claude Code settings. The shared rules live in
# .claude/settings.json and CLAUDE.md — those are version-controlled.
.claude/settings.local.json
.claude/hook-events.log

.cc-connect

# The logo sources and their slicer live outside the repository: only the
# result is in the project — the Tauri icons and the site SVG. While the folder
# is still here, these lines keep it out of the index.
/brand/
/tools/logo-build.mjs
