{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComfyUI Portable Organizer",
  "version": "0.1.4",
  "identifier": "io.github.quo0.comfyui-organizer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ComfyUI Portable Organizer",
        "width": 1100,
        "height": 700,
        "minWidth": 940,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Andrew Blokhin",
    "copyright": "Copyright (C) 2026 Andrew Blokhin. Licensed under the GNU GPL v3.",
    "homepage": "https://github.com/Quo0/ComfyUI-portable-organizer",
    "license": "GPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Quo0/ComfyUI-portable-organizer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVERDczQjA3MTA2ODFBREIKUldUYkdtZ1FCenZYWFJzcmN2L25oQmYrWkh4bDZ3UXE1aU9BNkY3VWl2RHQ1N05meUYvMkVKN2sK"
    }
  }
}
