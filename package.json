{
  "name": "comfyui-portable-organizer",
  "private": true,
  "version": "0.1.1",
  "description": "Managing ComfyUI portable builds: registry, launch, embedded tabs, shared models",
  "license": "GPL-3.0-only",
  "author": "Andrew Blokhin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quo0/ComfyUI-portable-organizer.git"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "desktop:dev": "pnpm --filter @cpo/desktop tauri dev --config src-tauri/tauri.dev.conf.json --features devtools",
    "desktop:build": "pnpm --filter @cpo/desktop tauri build",
    "docs:dev": "pnpm --filter @cpo/docs docs:dev",
    "docs:build": "pnpm --filter @cpo/docs docs:build",
    "ui-design:dev": "pnpm ui-design:tokens && pnpm --filter @cpo/ui-design docs:dev",
    "ui-design:build": "pnpm ui-design:tokens && pnpm --filter @cpo/ui-design docs:build",
    "ui-design:tokens": "node tools/build-preview-tokens.mjs",
    "ui-design:check": "node tools/build-preview-tokens.mjs && node tools/check-styles.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "typecheck": "pnpm --filter @cpo/desktop exec vue-tsc --noEmit",
    "kill": "node tools/kill-dev.mjs"
  }
}
