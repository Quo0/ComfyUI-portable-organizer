{
  "name": "comfyui-portable-organizer",
  "private": true,
  "version": "0.1.0",
  "description": "Управление портабл-сборками ComfyUI: реестр, запуск, встроенные вкладки, общие модели",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @cpo/desktop tauri dev --config src-tauri/tauri.dev.conf.json --features devtools",
    "dev:build-desktop": "pnpm --filter @cpo/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:docs": "pnpm --filter @cpo/docs docs:dev",
    "dev:design": "pnpm design:tokens && pnpm --filter @cpo/design docs:dev",
    "build:desktop": "pnpm --filter @cpo/desktop tauri build",
    "build:docs": "pnpm --filter @cpo/docs docs:build",
    "build:design": "pnpm design:tokens && pnpm --filter @cpo/design docs:build",
    "design:tokens": "node tools/build-preview-tokens.mjs",
    "design:check": "node tools/build-preview-tokens.mjs && node tools/check-styles.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "typecheck": "pnpm --filter @cpo/desktop exec vue-tsc --noEmit",
    "kill": "node tools/kill-dev.mjs"
  }
}
